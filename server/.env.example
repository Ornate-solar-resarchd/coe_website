# Copy this file to ".env" and fill in real values. Never commit .env.

# Port the backend listens on locally (the tunnel points here)
PORT=8787

# Your live site(s). The browser blocks requests from anywhere not listed here.
ALLOWED_ORIGINS=https://YOURDOMAIN.com,https://www.YOURDOMAIN.com

# --- Email (optional). Leave blank to just archive submissions to submissions.jsonl ---
# For Hostinger email (info@ornatesolar.com), get SMTP details from hPanel → Emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@ornatesolar.com
MAIL_TO=info@ornatesolar.com
